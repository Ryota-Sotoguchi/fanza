# このファイルを .env という名前でコピーして、値を書き換えてください。
# .env は Git に含まれません(.gitignore 済み)。

# DMMアフィリエイト API ID
DMM_API_ID=xxxxxxxxxxxxxxxxxxxx

# 収集(ItemList呼び出し)に使うアフィリエイトID。APIで使えるのは末尾が 990〜999 のものだけです。
# トーンごとの計測用ID(991〜995 など)は config.yaml の tracking.affiliate_ids で設定します。
DMM_AFFILIATE_ID=yourname-990

# Anthropic API キー
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
